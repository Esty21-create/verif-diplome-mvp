# Copier ce fichier en ".env" et ajuster si besoin.
# Utilisée pour construire l'URL de vérification encodée dans le QR code.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Mot de passe partagé pour accéder à /admin/emettre. À choisir vous-même,
# suffisamment long, et à ne jamais commiter dans git.
ADMIN_PASSWORD=""

# Clé secrète utilisée pour signer le cookie de session admin (HMAC-SHA256).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Clé secrète utilisée pour signer le cookie de session étudiant (/espace),
# distincte de celle de l'admin. Même méthode de génération que ci-dessus.
ETUDIANT_SESSION_SECRET=""

# Clé de chiffrement (AES-256-GCM, 32 octets en hexadécimal) des données
# personnelles sensibles de l'étudiant (nom, prénom, date de naissance).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : à sauvegarder en lieu sûr, séparément du reste du projet, et à
# NE JAMAIS commiter. La perte de cette clé rend irrécupérables toutes les
# données déjà chiffrées avec elle (voir README).
ENCRYPTION_KEY=""

# Envoi des codes de connexion par email (auto-inscription, /espace/code) via
# n'importe quel serveur SMTP (Gmail avec "mot de passe d'application", Brevo,
# Mailgun, OVH, serveur de l'établissement...). Renseignez au minimum
# SMTP_HOST et SMTP_FROM : l'envoi réel est alors activé automatiquement.
SMTP_HOST=""
# 587 (STARTTLS, défaut) ou 465 (TLS implicite)
SMTP_PORT="587"
# "true" seulement si le fournisseur impose TLS implicite hors port 465
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Expéditeur affiché, ex: "Vérif Diplômes ENSPY <no-reply@votre-domaine.cm>".
# Doit être une adresse autorisée par votre fournisseur (sinon rejet/spam).
SMTP_FROM=""

# MODE DÉMO : le code est AFFICHÉ À L'ÉCRAN au lieu d'être envoyé (aucune
# valeur d'authentification : n'importe qui connaissant un matricule
# pourrait se connecter). Comportement selon cette variable :
#   absente    -> envoi réel si SMTP configuré, sinon démo
#   "true"     -> démo forcée, même si le SMTP est configuré
#   "false"    -> envoi réel obligatoire : l'inscription est refusée tant que
#                 le SMTP n'est pas configuré (recommandé en production)
MODE_DEMO_CODE_CONNEXION=""

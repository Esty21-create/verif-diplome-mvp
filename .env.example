# Copier ce fichier en ".env" et ajuster si besoin.
# Utilisée pour construire l'URL de vérification encodée dans le QR code.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Mot de passe partagé pour accéder à /admin/emettre. À choisir vous-même,
# suffisamment long, et à ne jamais commiter dans git.
ADMIN_PASSWORD=""

# Clé secrète utilisée pour signer le cookie de session admin (HMAC-SHA256).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Clé secrète utilisée pour signer le cookie de session étudiant (/espace),
# distincte de celle de l'admin. Même méthode de génération que ci-dessus.
ETUDIANT_SESSION_SECRET=""

# Clé de chiffrement (AES-256-GCM, 32 octets en hexadécimal) des données
# personnelles sensibles de l'étudiant (nom, prénom, date de naissance).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : à sauvegarder en lieu sûr, séparément du reste du projet, et à
# NE JAMAIS commiter. La perte de cette clé rend irrécupérables toutes les
# données déjà chiffrées avec elle (voir README).
ENCRYPTION_KEY=""
